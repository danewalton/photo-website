---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { galleries } from '../data/galleries';
import { getHeroPhotos, getPhotosForGallery } from '../lib/photos';

const heroPhotos = getHeroPhotos();
---

<BaseLayout title="Home">
  <section class="hero">
    {heroPhotos.length > 0 && (
      <div class="hero-media" data-hero-cycle data-hero-interval="6000">
        {heroPhotos.map((photo, i) => (
          <Image
            class={`hero-image${i === 0 ? ' is-active' : ''}`}
            src={photo}
            alt=""
            width={1600}
            widths={[640, 1024, 1600]}
            loading={i === 0 ? 'eager' : 'lazy'}
            data-hero-slide
          />
        ))}
        <span class="scroll-cue" aria-hidden="true">&#8595;</span>
      </div>
    )}
    <div class="hero-text">
      <h1>Dane Walton Photography</h1>
      <p>Portraits, engagements, maternity, and life's milestones — captured simply and honestly.</p>
      <a class="button" href="/contact/">Get in touch</a>
    </div>
  </section>

  <div class="gallery-grid-nav">
    {galleries.map((g) => {
      const photos = getPhotosForGallery(g.slug);
      const cover = photos[0];
      return (
        <a href={`/galleries/${g.slug}/`}>
          {cover ? (
            <Image src={cover} alt="" width={600} />
          ) : (
            <div class="empty" style="height:100%;">Coming soon</div>
          )}
          <div class="label">
            <h3>{g.title}</h3>
          </div>
        </a>
      );
    })}
  </div>
</BaseLayout>

<script>
  const cycle = document.querySelector<HTMLElement>('[data-hero-cycle]');
  const slides = cycle ? Array.from(cycle.querySelectorAll<HTMLElement>('[data-hero-slide]')) : [];

  if (slides.length > 1) {
    const interval = Number(cycle?.dataset.heroInterval) || 6000;
    let current = slides.findIndex((slide) => slide.classList.contains('is-active'));
    if (current === -1) current = 0;

    setInterval(() => {
      const next = (current + 1) % slides.length;
      slides[current].classList.remove('is-active');
      slides[next].classList.add('is-active');
      current = next;
    }, interval);
  }
</script>
