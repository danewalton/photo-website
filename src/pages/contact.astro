---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch to book a session.">
  <div class="page-intro">
    <h1>Contact</h1>
    <p>Interested in booking a session? Reach out — I'd love to hear about it.</p>
  </div>

  <div class="container">
    <div class="contact-grid">
      <div>
        <h3>Email</h3>
        <p><a href="mailto:photo@danewalton.com">photo@danewalton.com</a></p>
      </div>
      <div>
        <h3>Instagram</h3>
        <p><a href="https://instagram.com/" target="_blank" rel="noopener noreferrer">@danewaltonphoto</a></p>
      </div>
      <div>
        <h3>Based in</h3>
        <p>Your City, State</p>
      </div>
    </div>
  </div>
</BaseLayout>
