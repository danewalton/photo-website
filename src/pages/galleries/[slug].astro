---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { galleries } from '../../data/galleries';
import { classifyAspect, getSessionsForGallery } from '../../lib/photos';

export function getStaticPaths() {
  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
    props: { gallery },
  }));
}

const { gallery } = Astro.props;
const sessions = getSessionsForGallery(gallery.slug);
const hasPhotos = sessions.some((session) => session.photos.length > 0);
---

<BaseLayout title={gallery.title} description={gallery.description}>
  <div class="page-intro">
    <h1>{gallery.title}</h1>
    <p>{gallery.description}</p>
  </div>

  {hasPhotos ? (
    <div class="gallery-body">
      {sessions.map((session) => (
        <section class="photo-session">
          <div class="container">
            {session.title && <h2 class="session-title">{session.title}</h2>}
            <div class="photo-grid">
              {session.photos.map((photo) => {
                const aspect = classifyAspect(photo);
                return (
                  <figure class={aspect === 'normal' ? undefined : `is-${aspect}`}>
                    {aspect === 'panoramic' ? (
                      <Image src={photo} alt="" width={1600} widths={[600, 1000, 1600]} />
                    ) : (
                      <Image src={photo} alt="" width={800} widths={[400, 800, 1200]} />
                    )}
                  </figure>
                );
              })}
            </div>
          </div>
        </section>
      ))}
    </div>
  ) : (
    <p class="empty-state">Photos from this collection are coming soon.</p>
  )}

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightbox-close">Close</button>
    <img id="lightbox-img" src="" alt="" />
  </div>
</BaseLayout>

<script>
  const body = document.querySelector('.gallery-body');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');

  body?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'IMG') {
      const img = target as HTMLImageElement;
      lightboxImg.src = img.src;
      lightbox?.classList.add('is-open');
    }
  });

  function close() {
    lightbox?.classList.remove('is-open');
    lightboxImg.src = '';
  }

  closeBtn?.addEventListener('click', close);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>
